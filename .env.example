# URL pública da aplicação. Na Vercel, use o domínio definitivo com https://.
APP_URL="https://seu-dominio.com.br"

# Supabase (somente o backend pode receber a service role key)
SUPABASE_PROJECT_REF="kmxskknkdceviavccnpo"
SUPABASE_URL="https://kmxskknkdceviavccnpo.supabase.co"
SUPABASE_ANON_KEY="cole-a-chave-anon"
# Segredo exclusivo do servidor. Nunca use prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY="cole-a-chave-service-role"

# ==========================================
# GATEWAYS DE PAGAMENTO AUTOMATIZADOS (PASSO 2)
# ==========================================
# Selecione o gateway ativo padrão: "simulated" | "mercadopago" | "efi_gerencianet" | "asaas" | "infinitepay"
PAYMENT_ACTIVE_GATEWAY="simulated"
PAYMENT_SANDBOX_MODE="true"

# 1. MERCADO PAGO
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_WEBHOOK_SECRET=""

# 2. EFI / GERENCIANET (PIX DIRETO BACEN)
# Obtenha em: https://app.sejaefi.com.br/api
EFI_CLIENT_ID=""
EFI_CLIENT_SECRET=""
EFI_PIX_KEY="financeiro@gordeixosbrasilia.com.br"
EFI_CERT_BASE64=""

# 3. ASAAS
# Obtenha em: https://www.asaas.com/config/api
ASAAS_API_KEY=""
ASAAS_WALLET_ID=""
ASAAS_WEBHOOK_SECRET=""

# 4. INFINITEPAY
# Obtenha em: https://infinitepay.io
INFINITEPAY_API_KEY=""
INFINITEPAY_HANDLE=""
INFINITEPAY_MERCHANT_ID=""
